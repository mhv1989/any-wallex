# ── کلیدهای API والکس (فقط سمت سرور؛ هرگز در کد فرانت یا لاگ قرار ندهید) ──
WALLEX_API_KEY=
*** رمز عبور برای رمزنگاری کلید در دیسک (Fernet + PBKDF2)
WALLEX_KEY_PASSWORD=
*** برای فعال‌سازی معامله واقعی باید "yes" باشد (پیش‌فرض: paper)
WALLEX_LIVE_ALLOWED=no

# ── تنظیمات موتور ──
BOT_CONFIG=config.yaml
BOT_DATA_DIR=data
