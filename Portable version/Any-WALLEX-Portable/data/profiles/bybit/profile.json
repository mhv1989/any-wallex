      "ts": 1788956038
    },
    {
      "category": "margin_model",
      "detail": "Unified Trading Account offers spot margin and USDT perpetuals with funding; not configured here (margin=null)",
      "ts": 1788956038
    }
  ],
  "margin_style": "futures",
  "_rules_from_ai": [
    "min_order_usdt",
    "min_collateral_usdt",
    "max_collateral_usdt",
    "max_risk_coef",
    "price_band_pct",
