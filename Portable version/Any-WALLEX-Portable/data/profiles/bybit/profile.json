{
  "schema_version": 1,
  "id": "bybit",
  "name": "Bybit",
  "base_url": "https://api.bybit.com",
  "auth": {
    "scheme": "hmac",
    "hmac": {
      "param_order": [
        "expires",
        "api_key",
        "query",
        "body"
      ],
      "headers": {
        "X-BAPI-API-KEY": "{key}",
        "X-BAPI-SIGN": "{sig}",
        "X-BAPI-TIMESTAMP": "{expires}",
        "X-BAPI-RECV-WINDOW": "5000"
      },
      "algo": "sha256"
    }
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDT",
      "USDC",
      "BTC",
      "ETH"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/v5/market/kline",
      "params": {
        "category": "spot",
        "symbol": "{symbol}",
        "interval": "{tf}",
        "start": "{from_ms}",
        "end": "{to_ms}",
        "limit": "{limit}"
      },
      "result_format": "arrays",
      "result_path": "result.list",
      "field_map": {
        "ts": "[0]",
        "open": "[1]",
        "high": "[2]",
        "low": "[3]",
        "close": "[4]",
        "volume": "[5]"
      }
    },
    "markets": {
      "method": "GET",
      "path": "/v5/market/instruments-info",
      "params": {
        "category": "spot",
        "limit": "1000"
      },
      "result_format": "objects",
      "result_path": "result.list",
      "field_map": {
        "symbol": "symbol",
        "base": "baseCoin",
        "quote": "quoteCoin"
      }
    },
    "ticker": {
      "method": "GET",
      "path": "/v5/market/tickers",
      "params": {
        "category": "spot",
        "symbol": "{symbol}"
      },
      "result_format": "objects",
      "result_path": "result.list",
      "field_map": {
        "symbol": "symbol",
        "price": "lastPrice"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/v5/market/orderbook",
      "params": {
        "category": "spot",
        "symbol": "{symbol}",
        "limit": "{limit}"
      },
      "result_format": "arrays",
      "result_path": "result",
      "field_map": {
        "bids": "b",
        "asks": "a",
        "price": "[0]",
        "qty": "[1]"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "D"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 1.0,
  "quotes": [
    "USDT",
    "USDC",
    "BTC",
    "ETH"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 0.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://bybit-exchange.github.io/docs/"
    ],
    "researched_at": 1788956038,
    "model": "wizard"
  },
  "capabilities_override": null,
  "status": "ready",
  "limitations": [
