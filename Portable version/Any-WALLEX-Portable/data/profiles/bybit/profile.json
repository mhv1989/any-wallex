    {
      "category": "auth_scheme",
      "detail": "Signature=HMAC_SHA256(secret, timestamp+api_key+recv_window+queryString(GET)|rawBody(POST)); GET uses query only, POST uses body only",
      "ts": 1788956038
    },
    {
      "category": "response_shape",
      "detail": "kline result.list is newest-first [startTimeMs,open,high,low,close,volume,turnover] string arrays; reverse for chronological",
      "ts": 1788956038
    },
    {
      "category": "response_shape",
      "detail": "orderbook returns result.b/result.a as [price,qty] string arrays",
      "ts": 1788956038
    },
    {
      "category": "response_shape",
      "detail": "instruments-info has no last price; fetch price via /v5/market/tickers",
