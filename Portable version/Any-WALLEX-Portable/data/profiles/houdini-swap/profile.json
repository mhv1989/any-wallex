{
  "schema_version": 1,
  "id": "houdini-swap",
  "name": "Houdini Swap",
  "base_url": "https://api-partner.houdiniswap.com",
  "auth": {
    "scheme": "header",
    "header_name": "Authorization"
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDT",
      "USDC"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/dexQuote",
      "params": {
        "tokenIdFrom": "{symbol}",
        "tokenIdTo": "{quote}",
        "amount": "1"
      },
      "result_format": "objects",
      "field_map": {
        "close": "amountOut"
      }
    },
    "markets": {
      "method": "GET",
      "path": "/dexTokens",
      "params": {},
      "result_format": "objects",
      "field_map": {
        "symbol": "_id"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 1.0,
  "quotes": [
    "USDT",
    "USDC"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 0.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://docs.houdiniswap.com/developer-hub/overview/what-you-can-build",
      "https://docs.houdiniswap.com/api-v1/swap-flows/dex-swap",
      "https://github.com/HoudiniSwap/houdini-api-examples",
      "https://github.com/HoudiniSwap/houdini-api-examples/blob/main/README.md"
    ],
    "researched_at": 1788960707,
    "model": "wizard"
  },
  "capabilities_override": null,
  "status": "error",
