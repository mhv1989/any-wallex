{
  "schema_version": 1,
  "id": "weex",
  "name": "WEEX",
  "base_url": "https://sapi.wexex.io",
  "auth": {
    "scheme": "hmac",
    "hmac": {
      "param_order": [
        "method",
        "path",
        "query",
        "body",
        "timestamp",
        "appkey"
      ],
      "headers": {
        "validate-algorithms": "HmacSHA256",
        "validate-appkey": "{key}",
        "validate-recvwindow": "5000",
        "validate-timestamp": "{timestamp}",
        "validate-signature": "{sig}"
      },
      "algo": "sha256"
    }
  },
  "symbol_format": {
    "separator": "_",
    "case": "lower",
    "quote_suffixes": [
      "usdt"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/v4/public/kline",
      "params": {
        "symbol": "{symbol}",
        "interval": "{tf}",
        "startTime": "{from_ms}",
        "endTime": "{to_ms}",
        "limit": "{limit}"
      },
      "result_format": "objects",
      "result_path": "result",
      "field_map": {
        "ts": "t",
        "open": "o",
        "high": "h",
        "low": "l",
        "close": "c",
        "volume": "q"
      }
    },
    "markets": {
      "method": "GET",
      "path": "/v4/public/symbol",
      "params": {
        "symbol": "{symbol}"
      },
      "result_format": "objects",
      "result_path": "result.symbols",
      "field_map": {
        "symbol": "symbol",
        "base": "baseCurrency",
        "quote": "quoteCurrency"
      }
    },
    "ticker": {
      "method": "GET",
      "path": "/v4/public/ticker",
      "params": {
        "symbol": "{symbol}"
      },
      "result_format": "objects",
      "result_path": "result",
      "field_map": {
        "symbol": "s",
        "last": "c",
        "open": "o",
        "high": "h",
        "low": "l",
        "volume": "q"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/v4/public/depth",
      "params": {
        "symbol": "{symbol}",
        "limit": "{limit}"
      },
      "result_format": "objects",
      "result_path": "result",
      "field_map": {
        "bids": "bids",
        "asks": "asks"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "1": "1m",
    "5": "5m",
    "15": "15m",
    "60": "1h",
    "240": "4h",
    "1D": "1d"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 0.1,
  "quotes": [
    "USDT"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 80.0,
    "qty_step": 6.0,
    "fee_pct": 0.1,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://www.weex.com/api-doc/spot/introduction/APIBriefIntroduction",
