{
  "schema_version": 1,
  "id": "bydfi",
  "name": "BYDFi",
  "base_url": "https://api.bydfi.com/api",
  "auth": {
    "scheme": "hmac",
    "hmac": {
      "param_order": [
        "method",
        "path",
        "query",
        "expires"
      ],
      "headers": {
        "X-API-KEY": "{{key}}",
        "X-API-SIGNATURE": "{{sig}}",
        "X-API-TIMESTAMP": "{{expires}}"
      },
      "algo": "sha256"
    }
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDT"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/v1/futures/market/kline",
      "params": {
        "contract": "{symbol}",
        "resolution": "{tf}",
        "from": "{from}",
        "to": "{to}"
      },
      "result_format": "udf",
      "result_path": "data"
    },
    "markets": {
      "method": "GET",
      "path": "/v1/futures/market/contracts",
      "params": {},
      "result_format": "objects",
      "result_path": "data",
      "field_map": {
        "symbol": "contract",
        "price": "lastPrice"
      }
    },
    "ticker": {
      "method": "GET",
      "path": "/v1/futures/market/ticker",
      "params": {
        "contract": "{symbol}"
      },
      "result_format": "objects",
      "result_path": "data",
      "field_map": {
        "symbol": "contract",
        "price": "lastPrice"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/v1/futures/market/depth",
      "params": {
        "contract": "{symbol}",
        "limit": "{limit}"
      },
      "result_format": "objects",
      "result_path": "data"
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 0.05,
  "quotes": [
    "USDT"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 0.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://developers.bydfi.com/en/intro",
