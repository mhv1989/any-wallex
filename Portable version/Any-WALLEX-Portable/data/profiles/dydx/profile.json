{
  "schema_version": 1,
  "id": "dydx",
  "name": "dYdX",
  "base_url": "https://indexer.dydx.trade/v4",
  "auth": {
    "scheme": "none"
  },
  "symbol_format": {
    "separator": "-",
    "case": "upper",
    "quote_suffixes": [
      "USD",
      "USDT"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/candles/perpetualMarkets/{symbol}",
      "params": {
        "resolution": "{tf}",
        "limit": "{limit}"
      },
      "result_path": "candles",
      "result_format": "objects",
      "field_map": {
        "ts": "startedAt",
        "open": "open",
        "high": "high",
        "low": "low",
        "close": "close",
        "volume": "baseTokenVolume"
      }
    },
    "markets": {
      "method": "GET",
      "path": "/perpetualMarkets",
      "params": {},
      "result_format": "objects",
      "result_path": "markets",
      "field_map": {
        "symbol": "ticker",
        "price": "oraclePrice"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15MINS",
    "60": "1HOUR",
    "240": "4HOURS",
    "1D": "1DAY"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 1.0,
  "quotes": [
    "USD"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 0.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
