{
  "schema_version": 1,
  "id": "binance",
  "name": "Binance",
  "base_url": "https://api.binance.com",
  "auth": {
    "scheme": "hmac",
    "header_name": "X-MBX-APIKEY",
    "hmac": {
      "param_order": [
        "query"
      ],
      "headers": {
        "X-MBX-APIKEY": "{key}"
      },
      "algo": "sha256"
    }
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDT",
      "USDC",
      "BTC",
      "ETH",
      "BNB",
      "FDUSD"
    ]
  },
  "endpoints": {
    "candles": {
      "method": "GET",
      "path": "/api/v3/klines",
      "params": {
        "symbol": "{symbol}",
        "interval": "{tf}",
        "startTime": "{from_ms}",
        "endTime": "{to_ms}",
        "limit": "{limit}"
      },
      "result_format": "arrays",
      "field_map": {
        "ts": "0",
        "open": "1",
        "high": "2",
        "low": "3",
        "close": "4",
        "volume": "5"
      }
    },
    "markets": {
      "method": "GET",
      "path": "/api/v3/exchangeInfo",
      "params": {},
      "result_format": "objects",
      "result_path": "symbols",
      "field_map": {
        "symbol": "symbol",
        "base": "baseAsset",
        "quote": "quoteAsset"
      }
    },
    "ticker": {
      "method": "GET",
      "path": "/api/v3/ticker/24hr",
      "params": {
        "symbol": "{symbol}"
      },
      "result_format": "objects",
      "field_map": {
        "symbol": "symbol",
        "price": "lastPrice",
        "bid": "bidPrice",
        "ask": "askPrice",
        "volume": "volume"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/api/v3/depth",
      "params": {
        "symbol": "{symbol}",
        "limit": "{limit}"
      },
      "result_format": "objects",
      "field_map": {
        "bids": "bids",
        "asks": "asks"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15m",
    "60": "1h",
    "240": "4h",
    "1D": "1d"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 0.1,
  "quotes": [
    "USDT",
    "USDC",
    "BTC",
    "ETH",
    "BNB"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 5.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://github.com/binance-exchange/binance-official-api-docs/blob/master/rest-api.md",
      "https://github.com/binance-exchange/binance-official-api-docs"
    ],
    "researched_at": 1788955876,
    "model": "wizard"
  },
  "capabilities_override": null,
  "status": "ready",
