{
  "schema_version": 1,
  "id": "edgex",
  "name": "edgeX",
  "base_url": "https://edgex-prod-v2.edgex.exchange",
  "auth": {
    "scheme": "header",
    "header_name": "X-EDGEX-SIGNATURE"
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDC"
    ]
  },
  "endpoints": {
    "markets": {
      "method": "GET",
      "path": "/api/v2/public/meta/getMetaData",
      "result_path": "data.contractList",
      "result_format": "objects",
      "field_map": {
        "symbol": "contractId",
        "base": "contractName"
      }
    },
    "candles": {
      "method": "GET",
      "path": "/api/v2/public/quote/getKline",
      "params": {
        "contractId": "{symbol}",
        "klineType": "{tf}",
        "priceType": "LAST_PRICE",
        "size": "{limit}"
      },
      "result_path": "data.dataList",
      "result_format": "objects",
      "field_map": {
        "ts": "klineTime",
        "open": "open",
        "high": "high",
        "low": "low",
        "close": "close",
        "volume": "size"
      }
    },
    "ticker": {
      "method": "GET",
      "path": "/api/v2/public/quote/getTicker",
      "params": {
        "contractId": "{symbol}"
      },
      "result_path": "data",
      "result_format": "objects",
      "field_map": {
        "symbol": "contractId",
        "price": "close"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/api/v2/public/quote/getDepth",
      "params": {
        "contractId": "{symbol}",
        "limit": "50"
      },
      "result_path": "data"
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "MINUTE_15",
    "60": "HOUR_1",
    "240": "HOUR_4",
    "1D": "DAY_1"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 1.0,
  "quotes": [
    "USDT"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 3.0,
    "price_band_pct": 0.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://edgexhelp.zendesk.com/hc/en-001/articles/16565803708303-API-Docs",
      "https://edgexhelp.zendesk.com/hc/en-001/articles/16565803708303-API-Docs-V2",
      "https://docs.edgexfoundry.org/3.1/microservices/device/services/device-rest/ApiReference/",
      "https://docs.edgexfoundry.org/3.1/api/Ch-APIIntroduction/",
      "https://fuji-docs.edgexfoundry.org/Ch-APIReference.html",
      "https://edgex-foundry.readthedocs.io/"
    ],
    "researched_at": 1788958591,
    "model": "wizard"
  },
  "capabilities_override": null,
