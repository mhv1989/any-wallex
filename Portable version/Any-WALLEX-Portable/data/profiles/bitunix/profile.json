{
  "schema_version": 1,
  "id": "bitunix",
  "name": "Bitunix",
  "base_url": "https://fapi.bitunix.com",
  "auth": {
    "scheme": "hmac",
    "hmac": {
      "param_order": [
        "method",
        "path",
        "query",
        "body",
        "timestamp",
        "nonce",
        "api_key"
      ],
      "headers": {
        "api-key": "{{api_key}}",
        "nonce": "{{nonce}}",
        "timestamp": "{{timestamp}}",
        "sign": "{{sign}}"
      },
      "algo": "double_sha256"
    }
  },
  "symbol_format": {
    "separator": "",
    "case": "upper",
    "quote_suffixes": [
      "USDT"
    ]
  },
  "endpoints": {
    "markets": {
      "method": "GET",
      "path": "/api/v1/futures/market/trading_pairs",
      "result_path": "data",
      "result_format": "objects",
      "field_map": {
        "symbol": "symbol",
        "base": "base",
        "quote": "quote",
        "price": "markPrice"
      }
    },
    "candles": {
      "method": "GET",
      "path": "/api/v1/futures/market/kline",
      "params": {
        "symbol": "{{symbol}}",
        "interval": "{{tf}}",
        "start": "{{from_ms}}",
        "end": "{{to_ms}}"
      },
      "result_path": "data",
      "result_format": "objects",
      "field_map": {
        "ts": "time",
        "open": "open",
        "high": "high",
        "low": "low",
        "close": "close",
        "volume": "quoteVol"
      }
    },
    "depth": {
      "method": "GET",
      "path": "/api/v1/futures/market/depth",
      "params": {
        "symbol": "{{symbol}}",
        "level": "5"
      },
      "result_path": "data"
    },
    "ticker": {
      "method": "GET",
      "path": "/api/v1/futures/market/tickers",
      "result_path": "data",
      "field_map": {
        "symbol": "symbol",
        "price": "lastPrice"
      }
    }
  },
  "margin": null,
  "tf_param_map": {
    "15": "15min",
    "60": "60min",
    "240": "4h",
    "1D": "1day"
  },
  "true_res_map": {
    "15": "15",
    "60": "60",
    "240": "240",
    "1D": "1D"
  },
  "min_gap_sec": 1.0,
  "quotes": [
    "USDT"
  ],
  "rules": {
    "min_order_usdt": 10.0,
    "min_collateral_usdt": 10.0,
    "max_collateral_usdt": 100000.0,
    "max_risk_coef": 200.0,
    "price_band_pct": 5.0,
    "qty_step": 8.0,
    "fee_pct": 0.2,
    "interest_per_4h_pct": 0.05
  },
  "docs": {
    "source_urls": [
      "https://www.bitunix.com/api-docs/",
      "https://www.bitunix.com/api-docs/futures/common/introduction.html",
      "https://www.bitunix.com/api-docs/spots/en_us/",
      "https://github.com/BitunixOfficial/open-api",
      "https://www.bitunix.com/hub/academy/operation-guide/bitunix-product-guide/bitunix-api-guide",
      "https://github.com/BitunixOfficial/open-api/blob/main/README.md"
    ],
