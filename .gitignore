# ── secrets & local state (never commit) ─────────────────────────
.key_password
secrets.enc
*.key
.env

# ── per-profile runtime data (DB, caches, keys, logs) ────────────
data/
Logs/
*.db
*.db-journal
*.db-wal
*.db-shm
*.corrupt

# ── python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.py.orig
*.bak
.venv/
venv/
.pytest_cache/

# ── scratch / debug leftovers ────────────────────────────────────
_*.py
_*.js
_*.json
.chk*
.shim*
.tmp*
.tmp_*
*.tmp

# ── OS / editor noise ────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
*.swp
Logs_verify/
.hermes/
*.hermes-tmp.*
bot/.hermes-tmp.*

# ── portable edition: ship CLEAN exchange configs, never runtime data ──
!Portable version/Any-WALLEX-Portable/data/
Portable version/Any-WALLEX-Portable/data/**
!Portable version/Any-WALLEX-Portable/data/exchange_catalog.json
!Portable version/Any-WALLEX-Portable/data/strategies/
Portable version/Any-WALLEX-Portable/data/strategies/**
